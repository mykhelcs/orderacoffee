# ==============================================================================
# CafeGo / COUGHFEE Environment Template (.env.example)
#
# Copy this file to .env and replace placeholders with your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# SMTP Configuration (Used for sending 6-digit OTP verification emails)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_REPLY_TO=noreply@yourdomain.com
SMTP_SENDER_NAME=COUGHFEE

# ------------------------------------------------------------------------------
# PayMongo Payment Gateway
# ------------------------------------------------------------------------------
PAYMONGO_PUBLIC_KEY=pk_test_...
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=whsk_...
PAYMONGO_SUCCESS_URL=https://cafego.ph/orders/success
PAYMONGO_CANCEL_URL=https://cafego.ph/orders/cancel

# ------------------------------------------------------------------------------
# Admin Account Configuration
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@cafego.ph
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Admin Staff
ADMIN_PHONE=+639123456789

# ------------------------------------------------------------------------------
# Firebase Project Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=coughfee-app
FIREBASE_STORAGE_BUCKET=coughfee-app.firebasestorage.app
FIREBASE_AUTH_DOMAIN=coughfee-app.firebaseapp.com
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id
