{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "coughfee-app",
          "appId": "1:580881321800:android:8c167f4dedc987f70d6d7d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "coughfee-app",
          "configurations": {
            "android": "1:580881321800:android:8c167f4dedc987f70d6d7d",
            "web": "1:580881321800:web:f77cfd94de9efdb80d6d7d"
          }
        }
      }
    }
  }
}
